	(text "R11 + R12 begrenzen den Kontaktstrom auf 3,3 V / 320 R = 10 mA"
		(exclude_from_sim no)
		(at 24.13 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1e007cdb-fd3d-54bd-9b9e-b7f22e36afef")
	)
	(text "R12 zusaetzlich als ESD-Strombegrenzung am Steckverbinder"
		(exclude_from_sim no)
		(at 24.13 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "09d6d6da-1ab9-5567-b0cd-612c62d39a00")
	)
	(text "D4 wird vom GPIO getrieben, damit sie im Tiefschlaf abschaltbar ist (NF-04)"
		(exclude_from_sim no)
		(at 24.13 232.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "551862b2-624e-555b-b95a-63bc433902c0")
	)
	(text "IO10, RXD und TXD bleiben frei - die Konsole laeuft ueber USB-Serial-JTAG."
		(exclude_from_sim no)
		(at 24.13 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d50162e8-ff17-59c5-9142-453dca819a1b")
	)
	(text "R3 = 0 R: Trennstelle fuer die Strommessung der Modulversorgung (M3, 4.5.6)"
		(exclude_from_sim no)
		(at 189.23 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a288af67-a841-516f-a6e9-c35f7616bc2a")
	)
	(text "IO2 und IO8 sind Strapping-Pins: R15 bzw. R16 halten sie beim Start hoch."
		(exclude_from_sim no)
		(at 189.23 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a253ec6a-655d-5811-8521-27aaeb34d179")
	)
	(text "IO18/IO19 fuehren direkt zur USB-Serial-JTAG-Einheit - keine Serienwiderstaende."
		(exclude_from_sim no)
		(at 189.23 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "81714f84-4652-52e2-bb0b-8f202da30a6c")
	)
	(text "IO3 ist RTC-faehig und weckt das Geraet aus dem Tiefschlaf (F-13)."
		(exclude_from_sim no)
		(at 189.23 148.59 0)
		(effects
			(font
